import {test} from 'node:test';import assert from 'node:assert/strict';import {randomBytes,randomUUID} from 'node:crypto'
import {readProfile,connect,issue,ledgers,revoke} from '../../scripts/private-review/card-store';import {upgradeRegistry,createPerson,people,loadCard,cardHistory,uploadDocument,listDocuments,loadDocument,archiveDocument,validatePdf,digest} from '../../scripts/private-review/registry-store';import {invalidSyntheticCpf} from '../../src/features/vitrine-premium/lib/review-registry';import {syntheticPdf} from './synthetic-pdf'
const profile=process.env.PAP_ID_REVIEW_PROFILE;if(!profile)throw Error('OWNED_DISPOSABLE_REVIEW_PROFILE_REQUIRED')
function person(){let document='';do{document='98'+String(randomBytes(4).readUInt32BE()%1000000000).padStart(9,'0')}while(!invalidSyntheticCpf(document));return {name:'Gestante Sintética Teste '+randomBytes(3).toString('hex'),birthDate:'1998-08-14',document,syntheticConsent:true as const}}
test('v2 additive upgrade preserves legacy rows; registration, encrypted credentials and versioned PDFs persist with audit',async()=>{
 const p=await readProfile(profile),db=connect(p);try{
 const before=await db.query('SELECT subject,patient_id,identity,revision FROM review_people ORDER BY patient_id');await upgradeRegistry(db,p);await upgradeRegistry(db,p);assert.deepEqual((await db.query('SELECT subject,patient_id,identity,revision FROM review_people ORDER BY patient_id')).rows,before.rows)
 const data=person(),op=randomUUID(),results=await Promise.all([createPerson(db,data,op),createPerson(db,data,op)]);assert.equal(results[0].subject,results[1].subject);const a=results[0];assert.equal((await people(db)).filter(i=>i.document===data.document).length,1);await assert.rejects(()=>createPerson(db,{...data,name:'Gestante Sintética Outro Nome'},randomUUID()));await assert.rejects(()=>createPerson(db,{...data,document:'12345678909'},randomUUID()))
 const token='PAP-ID-DEMO-1.'+randomBytes(32).toString('base64url');await issue(db,a.patientId,randomUUID(),token,p.cardKey);const card=(await cardHistory(db)).find(c=>c.patientId===a.patientId)!;const bytes=await loadCard(db,p,a.patientId,card.id);assert.equal(bytes!.subarray(0,4).toString('hex'),'89504e47');assert.equal(await loadCard(db,p,'foreign-patient',card.id),null);const ciphertext=(await db.query('SELECT encrypted FROM review_card_images WHERE id=$1',[card.id])).rows[0].encrypted;assert.notDeepEqual(ciphertext,bytes);assert.ok(!ciphertext.includes(Buffer.from(token)))
 const pdf=syntheticPdf(),uploadId=randomUUID(),doc=await uploadDocument(db,a.patientId,{name:'referencia-sintetica.pdf',category:'OUTRO_SINTETICO',operationId:uploadId},pdf);assert.equal(doc.version,1);assert.equal((await uploadDocument(db,a.patientId,{name:'referencia-sintetica.pdf',category:'OUTRO_SINTETICO',operationId:uploadId},pdf)).id,doc.id);assert.deepEqual((await loadDocument(db,a.patientId,doc.id))!.bytes,pdf);assert.equal(doc.sha256,digest(pdf));assert.equal(await loadDocument(db,'foreign-patient',doc.id),null)
 const b=await createPerson(db,person(),randomUUID());await assert.rejects(()=>uploadDocument(db,b.patientId,{name:'wrong.pdf',category:'OUTRO_SINTETICO',operationId:randomUUID(),groupId:doc.groupId},pdf));await assert.rejects(()=>uploadDocument(db,a.patientId,{name:'../escape.pdf',category:'OUTRO_SINTETICO',operationId:randomUUID()},pdf));
 const v2=await uploadDocument(db,a.patientId,{name:'referencia-v2.pdf',category:'OUTRO_SINTETICO',operationId:randomUUID(),groupId:doc.groupId},syntheticPdf('Segunda versao sintetica'));assert.equal(v2.version,2);assert.equal((await listDocuments(db,a.patientId)).length,2);assert.equal(await archiveDocument(db,b.patientId,doc.id),false);assert.equal(await archiveDocument(db,a.patientId,doc.id),true);assert.equal(await loadDocument(db,a.patientId,doc.id),null);assert.deepEqual((await loadDocument(db,a.patientId,v2.id))!.bytes,syntheticPdf('Segunda versao sintetica'))
 const again=connect(p);try{assert.equal((await people(again)).find(i=>i.subject===a.subject).document,data.document);assert.deepEqual(await loadCard(again,p,a.patientId,card.id),bytes);assert.equal((await listDocuments(again,a.patientId)).length,2)}finally{await again.end()}
 const audit=(await db.query('SELECT kind FROM review_audit WHERE subject=$1 ORDER BY id',[a.subject])).rows.map(r=>r.kind);assert.deepEqual(audit,['PERSON_CREATED','CARD_ISSUED','DOCUMENT_UPLOADED','DOCUMENT_UPLOADED','DOCUMENT_ARCHIVED']);await assert.rejects(()=>db.query("UPDATE review_audit SET actor='changed' WHERE subject=$1",[a.subject]));await revoke(db,a.subject);assert.ok((await ledgers(db)).find(l=>l.patient.subject===a.subject)!.cards.every(c=>c.revoked))
 }finally{await db.end()}
});
test('PDF parser rejects corruption, oversized payload, JavaScript and unsupported embedded behavior',async()=>{
 assert.equal(await validatePdf(syntheticPdf()),1);for(const bytes of [Buffer.from('<html>not pdf</html>'),Buffer.from('%PDF-1.4\ncorrupted data\n%%EOF'),Buffer.alloc(5242881),syntheticPdf('Script proibido',true)])await assert.rejects(()=>validatePdf(bytes))
});
