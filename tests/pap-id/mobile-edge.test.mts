import {test} from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import https from 'node:https';import net from 'node:net';import {execFileSync} from 'node:child_process';import {mkdtemp,readFile} from 'node:fs/promises';import {tmpdir} from 'node:os';import path from 'node:path';import {randomBytes} from 'node:crypto'
import {expectedReviewOrigin,privateOrigin} from '../../scripts/private-review/documents'
import {createMobileEdge,mobilePathAllowed,mobilePolicy,privateIpv4} from '../../scripts/private-review/mobile-edge'
const assets=new Set(['/images/test.png'])
test('LAN edge rejects public/wildcard origins, operational routes and traversal without widening the allowlist',()=>{
 for(const ip of ['0.0.0.0','8.8.8.8','127.0.0.1','169.254.1.2','192.168.1.999'])assert.equal(privateIpv4(ip),false);assert.ok(privateIpv4('192.168.1.10'));assert.ok(privateIpv4('172.20.1.2'));
 for(const p of ['/homologacao/documentos/sepse-obstetrica?token=private','/homologacao/pacientes/a/prontuario?download=1','/homologacao/pacientes/a/prontuario/x','/homologacao/documentos/unknown','/api/clinical/patients','/api/admin/organizations','/dashboard','/vitrine/chat','/vitrine/cursos','/vitrine/aprender/a','/vitrine/pacientes/../../api','/vitrine/%2e%2e/dashboard','//evil.invalid/x','/homologacao/pacientes/a/documentos/%2fprivate','/_next/image?url=/homologacao/x&w=640&q=75'])assert.equal(mobilePathAllowed(p,assets),false,p)
 for(const p of ['/homologacao/documentos/sepse-obstetrica?download=1','/vitrine/dashboard','/vitrine/registro','/vitrine/pacientes/review-123','/homologacao/sessao','/homologacao/pacientes/review-123/prontuario','/homologacao/atividade','/images/test.png'])assert.equal(mobilePathAllowed(p,assets),true,p)
 assert.throws(()=>mobilePolicy({origin:'https://8.8.8.8:4443',bind:'0.0.0.0',backend:'http://127.0.0.1:3001',proxySecret:'0'.repeat(64),cert:Buffer.alloc(0),key:Buffer.alloc(0),assets}))
 for(const port of [3100,3200,3300,3500,3600,15436,5432])assert.throws(()=>mobilePolicy({origin:'https://192.168.1.10:'+port,bind:'192.168.1.10',backend:'http://127.0.0.1:3001',proxySecret:'0'.repeat(64),cert:Buffer.alloc(0),key:Buffer.alloc(0),assets}));
})
test('trusted HTTPS pairing, exact origin, Secure cookie, revocation, rate limiting and proxy header isolation',async()=>{
 const dir=await mkdtemp(path.join(tmpdir(),'pap-mobile-cert-'));execFileSync('openssl',['req','-x509','-newkey','rsa:2048','-nodes','-days','1','-subj','/CN=127.0.0.1','-addext','subjectAltName=IP:127.0.0.1','-keyout',path.join(dir,'key.pem'),'-out',path.join(dir,'cert.pem')],{stdio:'ignore'});const cert=await readFile(path.join(dir,'cert.pem')),key=await readFile(path.join(dir,'key.pem'));let forwarded=false
 const backend=http.createServer((req,res)=>{forwarded=req.headers['x-pap-private-edge']===secret&&!req.headers['x-forwarded-for']&&!req.headers.authorization&&!req.headers['x-pap-beta-proxy-token'];res.end('synthetic')});await new Promise<void>(r=>backend.listen(0,'127.0.0.1',r));const backendPort=(backend.address() as net.AddressInfo).port,secret=randomBytes(32).toString('hex')
 const reserve=net.createServer();await new Promise<void>(r=>reserve.listen(0,'127.0.0.1',r));const port=(reserve.address() as net.AddressInfo).port;await new Promise<void>(r=>reserve.close(()=>r()));const origin=`https://127.0.0.1:${port}`,edge=createMobileEdge({origin,bind:'127.0.0.1',backend:`http://127.0.0.1:${backendPort}`,proxySecret:secret,cert,key,assets,testLoopback:true,lifetimeMs:60000});await new Promise<void>(r=>edge.server.listen(port,'127.0.0.1',r))
 const request=(route:string,method='GET',headers:Record<string,string>={},body='')=>new Promise<{status:number;headers:http.IncomingHttpHeaders;body:string}>((resolve,reject)=>{const req=https.request(origin+route,{method,ca:cert,headers},res=>{const data:Buffer[]=[];res.on('data',c=>data.push(c));res.on('end',()=>resolve({status:res.statusCode!,headers:res.headers,body:Buffer.concat(data).toString()}))});req.on('error',reject);req.end(body)})
 try{assert.equal((await request('/vitrine/dashboard')).status,303);assert.equal((await request('/homologacao/parear')).status,200);assert.equal((await request('/homologacao/parear','POST',{'content-type':'application/x-www-form-urlencoded',origin:'https://evil.invalid'},'code='+edge.pairingCode)).status,403);assert.equal((await request('/homologacao/parear','POST',{'content-type':'application/x-www-form-urlencoded',origin},'code=wrong')).status,403)
 const admitted=await request('/homologacao/parear','POST',{'content-type':'application/x-www-form-urlencoded',origin},'code='+edge.pairingCode);assert.equal(admitted.status,303);assert.equal(admitted.headers['referrer-policy'],'same-origin');const cookie=admitted.headers['set-cookie']![0].split(';')[0];assert.match(admitted.headers['set-cookie']![0],/HttpOnly; Secure; SameSite=Strict/)
 assert.equal((await request('/vitrine/dashboard','GET',{cookie,origin,'x-forwarded-for':'8.8.8.8',authorization:'test-only-fake','x-pap-beta-proxy-token':'forged'})).status,200);assert.ok(forwarded);assert.equal((await request('/api/clinical/patients','GET',{cookie})).status,404);assert.equal((await request('/vitrine/dashboard','POST',{cookie,origin})).status,405);assert.equal((await request('/vitrine/dashboard','GET',{cookie,origin:'https://evil.invalid'})).status,403);assert.equal((await request('/homologacao/sair','POST',{cookie,origin})).status,303);assert.equal((await request('/vitrine/dashboard','GET',{cookie})).status,303)
 const second=await request('/homologacao/parear','POST',{'content-type':'application/x-www-form-urlencoded',origin},'code='+edge.pairingCode);const other=second.headers['set-cookie']![0].split(';')[0];assert.equal((await request('/vitrine/dashboard','GET',{cookie:other})).status,200);edge.revokeAll();assert.equal((await request('/vitrine/dashboard','GET',{cookie:other})).status,303);for(let i=0;i<5;i++)assert.equal((await request('/homologacao/parear','POST',{'content-type':'application/x-www-form-urlencoded',origin},'code=wrong')).status,403);assert.equal((await request('/homologacao/parear','POST',{'content-type':'application/x-www-form-urlencoded',origin},'code='+edge.pairingCode)).status,429);
 edge.revokeAll();assert.equal((await request('/vitrine/dashboard','GET',{cookie})).status,303)
  const expired=createMobileEdge({origin,bind:'127.0.0.1',backend:`http://127.0.0.1:${backendPort}`,proxySecret:secret,cert,key,assets,testLoopback:true,lifetimeMs:1});edge.close();await new Promise(r=>setTimeout(r,20));await new Promise<void>(r=>expired.server.listen(port,'127.0.0.1',r));try{assert.equal((await request('/homologacao/parear')).status,403)}finally{expired.close()}
 }finally{edge.close();await new Promise<void>(r=>backend.close(()=>r()))}
})

test('private backend accepts the exact TLS Origin only with its internal edge secret, never a forged proxy header',()=>{
 const names=['PAP_PRIVATE_REVIEW','PAP_PRIVATE_REVIEW_ORIGIN','PAP_PRIVATE_REVIEW_EDGE_SECRET','PAP_PRIVATE_REVIEW_MOBILE_ORIGIN'],before=names.map(n=>process.env[n]);
 try{Object.assign(process.env,{PAP_PRIVATE_REVIEW:'1',PAP_PRIVATE_REVIEW_ORIGIN:'http://127.0.0.1:40123',PAP_PRIVATE_REVIEW_EDGE_SECRET:'a'.repeat(64),PAP_PRIVATE_REVIEW_MOBILE_ORIGIN:'https://192.168.1.10:34443'});
 const make=(secret?:string,origin='https://192.168.1.10:34443')=>new Request('http://localhost:40123/homologacao/sessao',{headers:{host:'127.0.0.1:40123',origin,...(secret?{'x-pap-private-edge':secret}:{})}});
 for(const secret of [undefined,'b'.repeat(64),'é'.repeat(64)])assert.equal(privateOrigin(make(secret)),false);assert.equal(privateOrigin(make('a'.repeat(64))),true);assert.equal(expectedReviewOrigin(make('a'.repeat(64))),'https://192.168.1.10:34443');assert.equal(privateOrigin(make('a'.repeat(64),'https://evil.invalid')),false);assert.equal(privateOrigin(make(undefined,'http://127.0.0.1:40123')),true);
 }finally{names.forEach((n,i)=>{if(before[i]===undefined)delete process.env[n];else process.env[n]=before[i]})}
});
