import {test} from 'node:test';import assert from 'node:assert/strict';import {randomBytes,randomUUID} from 'node:crypto';import {execFileSync} from 'node:child_process';import {writeFile,mkdir} from 'node:fs/promises'
import {readProfile,connect,issue} from '../../scripts/private-review/card-store';import {createPerson,cardHistory,loadCard,uploadDocument,loadDocument,people,digest} from '../../scripts/private-review/registry-store';import {invalidSyntheticCpf} from '../../src/features/vitrine-premium/lib/review-registry';import {syntheticPdf} from './synthetic-pdf'
test('owned PostgreSQL restart retains every registry row, new patient, recoverable card and exact private PDF bytes',async()=>{
 const file=process.env.PAP_ID_REVIEW_PROFILE;if(!file)throw Error('OWNED_DISPOSABLE_REVIEW_PROFILE_REQUIRED');const p=await readProfile(file);assert.match(p.project,/^pap-id-review-[a-f0-9]{12}$/);const db=connect(p);let document='';do{document='98'+String(randomBytes(4).readUInt32BE()%1000000000).padStart(9,'0')}while(!invalidSyntheticCpf(document));
 const patient=await createPerson(db,{name:'Gestante Sintética Reinício '+randomBytes(3).toString('hex'),document,birthDate:'1998-01-01',syntheticConsent:true},randomUUID());await issue(db,patient.patientId,randomUUID(),'PAP-ID-DEMO-1.'+randomBytes(32).toString('base64url'),p.cardKey);const card=(await cardHistory(db)).find(c=>c.patientId===patient.patientId)!;const png=await loadCard(db,p,patient.patientId,card.id);const pdf=syntheticPdf('Persistencia apos reinicio sintetico');const uploaded=await uploadDocument(db,patient.patientId,{name:'reinicio-sintetico.pdf',category:'OUTRO_SINTETICO',operationId:randomUUID()},pdf);
 const before=await db.query("SELECT jsonb_build_object('people',(SELECT jsonb_agg(to_jsonb(t) ORDER BY subject) FROM review_people t),'cards',(SELECT jsonb_agg(to_jsonb(t) ORDER BY hash) FROM review_cards t),'images',(SELECT jsonb_agg(to_jsonb(t) ORDER BY id) FROM review_card_images t),'documents',(SELECT jsonb_agg(to_jsonb(t) ORDER BY id) FROM review_documents t),'audit',(SELECT jsonb_agg(to_jsonb(t) ORDER BY id) FROM review_audit t)) AS state");await db.end();
 execFileSync('docker',['stop',p.project+'-db'],{stdio:'ignore'});execFileSync(process.execPath,['node_modules/tsx/dist/cli.mjs','scripts/pap-id/review-lab.mts','--action','start','--profile',file],{stdio:'ignore'});for(let i=0;i<30;i++){try{execFileSync('docker',['exec',p.project+'-db','pg_isready','-U',p.user,'-d',p.database],{stdio:'ignore'});break}catch{if(i===29)throw Error('OWNED_DATABASE_NOT_READY');await new Promise(r=>setTimeout(r,250))}}
 const next=await readProfile(file),again=connect(next);try{const after=await again.query("SELECT jsonb_build_object('people',(SELECT jsonb_agg(to_jsonb(t) ORDER BY subject) FROM review_people t),'cards',(SELECT jsonb_agg(to_jsonb(t) ORDER BY hash) FROM review_cards t),'images',(SELECT jsonb_agg(to_jsonb(t) ORDER BY id) FROM review_card_images t),'documents',(SELECT jsonb_agg(to_jsonb(t) ORDER BY id) FROM review_documents t),'audit',(SELECT jsonb_agg(to_jsonb(t) ORDER BY id) FROM review_audit t)) AS state");assert.deepEqual(after.rows,before.rows);assert.equal((await people(again)).find(a=>a.patientId===patient.patientId)?.name,patient.name);assert.deepEqual(await loadCard(again,next,patient.patientId,card.id),png);assert.deepEqual((await loadDocument(again,patient.patientId,uploaded.id))!.bytes,pdf);await mkdir('.local/final-local',{recursive:true});await writeFile('.local/final-local/restart-fixture.json',JSON.stringify({patientId:patient.patientId,name:patient.name,cardId:card.id,cardHash:digest(png!),documentId:uploaded.id,documentHash:digest(pdf)}),{mode:0o600});console.log('All private registry rows unchanged across owned database restart; exact PNG/PDF recovered.')}finally{await again.end()}
});
