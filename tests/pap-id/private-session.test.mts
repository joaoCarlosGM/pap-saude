import {test} from 'node:test';import assert from 'node:assert/strict';import {randomBytes} from 'node:crypto'
import {session,authorized,documentResponse} from '../../scripts/private-review/documents';import {cardResponse} from '../../scripts/private-review/card-api';import {registryResponse} from '../../scripts/private-review/registry-api'
test('private consent expires fail-closed for original PDFs, credentials and patient documents, and cannot be silently renewed',async()=>{
 const names=['PAP_PRIVATE_REVIEW','PAP_PRIVATE_REVIEW_ORIGIN','PAP_PRIVATE_REVIEW_ROOT','PAP_PRIVATE_REVIEW_SECRET','PAP_PRIVATE_REVIEW_EXPIRES'],before=names.map(k=>process.env[k]);const origin='http://127.0.0.1:49161';
 try{Object.assign(process.env,{PAP_PRIVATE_REVIEW:'1',PAP_PRIVATE_REVIEW_ORIGIN:origin,PAP_PRIVATE_REVIEW_ROOT:process.cwd(),PAP_PRIVATE_REVIEW_SECRET:randomBytes(32).toString('hex'),PAP_PRIVATE_REVIEW_EXPIRES:String(Date.now()+60000)});const headers={host:'127.0.0.1:49161',origin,'x-pap-local-review':'consent'},request=(path:string,extra:Record<string,string>={})=>new Request(origin+path,{headers:{...headers,...extra}});
 const granted=await session(new Request(origin+'/homologacao/sessao',{method:'POST',headers,body:JSON.stringify({consent:true})}));assert.equal(granted.status,200);const cookie=granted.headers.get('set-cookie')!.split(';')[0],valid={cookie};assert.equal(authorized(request('/homologacao/sessao',valid)),true);assert.equal((await documentResponse(request('/homologacao/documentos/sepse-obstetrica',valid),'sepse-obstetrica')).status,200);assert.equal(authorized(request('/homologacao/sessao',{cookie:'pap_private_document_review=forged'})),false);
 process.env.PAP_PRIVATE_REVIEW_EXPIRES=String(Date.now()-1);assert.equal(authorized(request('/homologacao/sessao',valid)),false);assert.equal((await documentResponse(request('/homologacao/documentos/sepse-obstetrica',valid),'sepse-obstetrica')).status,403);assert.equal((await cardResponse(request('/homologacao/carteirinhas',valid))).status,403);assert.equal((await registryResponse(request('/homologacao/pacientes/maria-gracas/documentos',valid),'maria-gracas','documentos')).status,403);assert.equal((await session(new Request(origin+'/homologacao/sessao',{method:'POST',headers,body:JSON.stringify({consent:true})}))).status,403);
 const ended=await session(new Request(origin+'/homologacao/sessao',{method:'DELETE',headers:{...headers,cookie}}));assert.equal(ended.status,200);assert.match(ended.headers.get('set-cookie')!,/Max-Age=0/)
 }finally{names.forEach((n,i)=>{if(before[i]===undefined)delete process.env[n];else process.env[n]=before[i]})}
});
