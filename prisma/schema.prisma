generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AlertLevel {
  GREEN
  YELLOW
  RED
}

enum MeowsEvaluationStatus {
  COMPLETE
  INCOMPLETE
  POLICY_UNRESOLVED
  INVALID
}

enum ConsciousnessState {
  ALERT
  VOICE
  PAIN
  UNRESPONSIVE
}

enum OrganizationType {
  PAP
  MUNICIPALITY
  HEALTH_UNIT
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  REQUESTED
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum OnboardingStatus {
  STARTED
  COMPLETED
  SKIPPED
}

enum OrganizationCandidateStatus {
  READY_FOR_ACTIVATION
  CHANGES_REQUESTED
  NEW
  QUALIFYING
  CONTACTED
  INTERESTED
  VALIDATING
  APPROVED
  REJECTED
  DUPLICATE
  CLOSED
}

enum OrganizationLeadTemperature {
  COLD
  WARM
  HOT
}

enum OrganizationRequestStatus {
  REQUESTED
  WITHDRAWN
  RESOLVED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum PregnancyStatus {
  ACTIVE
  COMPLETED
  INTERRUPTED
}

enum EncounterStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EdemaGrade {
  NONE
  ONE_PLUS
  TWO_PLUS
  THREE_PLUS
  FOUR_PLUS
}

enum ProteinuriaResult {
  NOT_PERFORMED
  NEGATIVE
  TRACE
  ONE_PLUS
  TWO_PLUS
  THREE_PLUS
  FOUR_PLUS
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  RESOLVED
  ENTERED_IN_ERROR
}

enum ClinicalFlagStatus {
  ACTIVE
  RESOLVED
  ENTERED_IN_ERROR
}

enum IntegrationEnvironment {
  SANDBOX
  HOMOLOGATION
  PRODUCTION
}

enum RNDSIntegrationStatus {
  NOT_REQUESTED
  REQUESTED
  CONFIGURING
  VALIDATING
  HOMOLOGATION
  PENDING_PAP_APPROVAL
  APPROVED
  ACTIVE
  DEGRADED
  SUSPENDED
  DISABLED
}

enum ValidationRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

enum ValidationResultStatus {
  PASSED
  FAILED
  SKIPPED
}

enum IntegrationPolicyAction {
  ALLOW
  DENY
}

enum ProductFeedbackCategory {
  BUG
  USABILITY
  FEATURE_REQUEST
  PERFORMANCE
  SUPPORT
  OTHER
}

enum ProductFeedbackStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ProductFeedbackSource {
  WEB
  MOBILE
  SUPPORT
  ADMIN
}

enum OrganizationHealthAlertType {
  LOW_ACTIVITY
  LOW_SATISFACTION
  FEEDBACK_BACKLOG
}

enum OrganizationHealthAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OrganizationHealthAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ClinicalProvenanceKind {
  REVISION_PROPOSAL
  MEASUREMENT_CREATED
  MEASUREMENT_UPDATED
}

enum ClinicalProvenanceStatus {
  PROPOSED_NOT_APPLIED
  APPLIED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships             Membership[]
  organizationRequests    OrganizationRequest[]
  roleAssignments         RoleAssignment[]
  auditEvents             AuditEvent[]          @relation("AuditActor")
  approvedRndIntegrations RNDSIntegration[]     @relation("RNDSApprovedBy")
  validationRuns          RNDSValidationRun[]   @relation("ValidationRunRequestedBy")

  passwordResetTokens    PasswordResetToken[]
  passwordCredential    PasswordCredential?
  mfaFactors            MfaFactor[]
  mfaRecoveryCodes      MfaRecoveryCode[]
  mfaChallenges         MfaChallenge[]
  sessions              Session[]
  productActivityEvents ProductActivityEvent[]   @relation("ProductActivityActor")
  sentInvitations       UserInvitation[]         @relation("InvitationSender")
  receivedInvitations   UserInvitation[]         @relation("InvitationUser")
  onboardingProgress    UserOnboardingProgress[]
  accessInvitations     AccessInvitation[] @relation("AccessRecipient")
  sentAccessInvitations AccessInvitation[] @relation("AccessSender")
  accessDecisions       AccessInvitation[] @relation("AccessReviewer")
  notifications         UserNotification[]
  authoredCourses Course[] @relation("CourseAuthor")
  courseAssets CourseAsset[]
  coursePublications CoursePublication[]
  courseReleases CourseAudience[]
  assignedCourses CourseAssignment[] @relation("CourseAssigner")
  receivedCourses CourseAssignment[] @relation("CourseRecipient")
  enrollments CourseEnrollment[]

  submittedFeedback ProductFeedback[] @relation("ProductFeedbackActor")
  resolvedFeedback  ProductFeedback[] @relation("ProductFeedbackResolver")

  @@map("users")
  clinicalProvenanceEvents ClinicalProvenanceEvent[] @relation("ClinicalProvenanceActor")
  clinicalRegistrations ClinicalRegistrationOperation[] @relation("ClinicalRegistrationActor")
}

model Organization {
  courseAudiences CourseAudience[]
  courseAssignments CourseAssignment[]
  id        String             @id @default(uuid())
  type      OrganizationType
  status    OrganizationStatus @default(PENDING_VERIFICATION)
  name      String
  code      String?            @unique
  cnes      String?            @unique
  cnpj      String?            @unique
  city      String?
  state     String?
  address   String?
  parentId  String?
  parent    Organization?      @relation("OrganizationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Organization[]     @relation("OrganizationTree")
  isActive  Boolean            @default(true)
  settings  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships           Membership[]
  sourceCandidate       OrganizationCandidate?       @relation("CandidateConversion")
  roleAssignments       RoleAssignment[]
  patientLinks          PatientOrganization[]
  encounters            Encounter[]
  rndsIntegration       RNDSIntegration?
  productActivityEvents ProductActivityEvent[]       @relation("ProductActivityOrganization")
  metricSnapshots       OrganizationMetricSnapshot[]
  userInvitations       UserInvitation[]

  productFeedback ProductFeedback[]

  healthAlerts OrganizationHealthAlert[]

  @@index([parentId])
  @@index([type, status])
  @@index([city, state])
  @@index([name])
  @@map("organizations")
  clinicalProvenanceEvents ClinicalProvenanceEvent[]
  clinicalRegistrations ClinicalRegistrationOperation[] @relation("ClinicalRegistrationOrganization")
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

model UserOnboardingProgress {
  id          String           @id @default(uuid())
  userId      String
  tourKey     String
  tourVersion Int
  status      OnboardingStatus @default(STARTED)
  currentStep Int              @default(0)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  skippedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tourKey, tourVersion])
  @@index([userId, status])
  @@index([tourKey, tourVersion])
  @@map("user_onboarding_progress")
}

model UserInvitation {
  id              String           @id @default(uuid())
  email           String
  displayName     String
  userId          String?
  organizationId  String
  roleKey         String
  deliveryStatus  String           @default("NOT_ATTEMPTED")
  providerMessageId String?
  deliveryAttemptedAt DateTime?
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user         User?        @relation("InvitationUser", fields: [userId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("user_invitations")
}

// Independent from legacy institutional acceptance: consent never grants IAM.
enum AccessInvitationStatus {
  PENDING_ACCEPTANCE
  PENDING_ASSIGNMENT
  ACTIVE
  REJECTED
  EXPIRED
  REVOKED
}

model AccessInvitation {
  id               String @id @default(uuid())
  email            String
  displayName      String
  proposedRoleKey  String
  status           AccessInvitationStatus @default(PENDING_ACCEPTANCE)
  activeSlot       Int? @default(1)
  tokenHash        String? @unique
  tokenVersion     Int @default(1)
  expiresAt        DateTime
  acceptedAt       DateTime?
  decidedAt        DateTime?
  decisionReason   String?
  revokedAt        DateTime?
  deliveryStatus   String @default("PENDING")
  userId           String?
  invitedByUserId  String
  reviewedByUserId String?
  assignmentId     String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User? @relation("AccessRecipient", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy  User @relation("AccessSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("AccessReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  assignment RoleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  notifications UserNotification[]

  @@unique([email, activeSlot])
  @@index([invitedByUserId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("access_invitations")
}

model UserNotification {
  id           String @id @default(uuid())
  userId       String
  invitationId String?
  courseEnrollmentId String?
  coursePublicationId String?
  kind         String
  dedupeKey    String @unique
  readAt       DateTime?
  emailStatus  String @default("PENDING")
  createdAt    DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseEnrollment CourseEnrollment? @relation(fields: [courseEnrollmentId], references: [id], onDelete: Restrict)
  coursePublication CoursePublication? @relation(fields: [coursePublicationId], references: [id], onDelete: Restrict)
  invitation AccessInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("user_notifications")
}

model OrganizationCandidate {
  id                      String                      @id @default(uuid())
  type                    OrganizationType
  name                    String
  normalizedName          String
  dedupeKey               String                      @unique
  cnes                    String?                     @unique
  cnpj                    String?
  city                    String?
  state                   String?
  address                 String?
  status                  OrganizationCandidateStatus @default(NEW)
  leadTemperature         OrganizationLeadTemperature @default(COLD)
  contactName             String?
  contactEmail            String?
  contactPhone            String?
  consentedAt             DateTime?
  reviewReason            String?
  reviewedByUserId         String?
  reviewedAt              DateTime?
  convertedOrganizationId String?                     @unique
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  convertedOrganization Organization?         @relation("CandidateConversion", fields: [convertedOrganizationId], references: [id], onDelete: SetNull)
  requests              OrganizationRequest[]

  @@index([type, status])
  @@index([leadTemperature, status])
  @@index([city, state])
  @@index([normalizedName])
  @@map("organization_candidates")
}

model OrganizationRequest {
  id                String                    @id @default(uuid())
  candidateId       String
  requestedByUserId String?
  status            OrganizationRequestStatus @default(REQUESTED)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  candidate   OrganizationCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requestedBy User?                 @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@unique([candidateId, requestedByUserId])
  @@index([requestedByUserId, status])
  @@index([candidateId, status])
  @@map("organization_requests")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions     RolePermission[]
  roleAssignments RoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id             String  @id @default(uuid())
  userId         String
  roleId         String
  organizationId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessInvitation AccessInvitation?

  @@unique([userId, roleId, organizationId])
  @@index([userId, organizationId])
  @@map("role_assignments")
}

model Patient {
  id         String   @id @default(uuid())
  cpf        String?  @unique
  cns        String?  @unique
  fullName   String
  socialName String?
  birthDate  DateTime
  phone      String?
  email      String?
  address    String?
  city       String?
  state      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organizations       PatientOrganization[]
  pregnancies         Pregnancy[]
  encounters          Encounter[]
  allergies           Allergy[]
  clinicalFlags       ClinicalFlag[]
  clinicalEvaluations ClinicalEvaluation[]
  clinicalAuditEvents AuditEvent[]          @relation("ClinicalAuditPatient")

  @@index([fullName, birthDate])
  @@index([birthDate])
  @@index([isActive])
  @@map("patients")
  clinicalProvenanceEvents ClinicalProvenanceEvent[]
  registrationOperations ClinicalRegistrationOperation[] @relation("ClinicalRegistrationPatient")
}

model PatientOrganization {
  id              String    @id @default(uuid())
  patientId       String
  organizationId  String
  medicalRecordNo String?
  isPrimary       Boolean   @default(false)
  linkedAt        DateTime  @default(now())
  unlinkedAt      DateTime?

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([patientId, organizationId])
  @@unique([organizationId, medicalRecordNo])
  @@index([organizationId, isPrimary])
  @@map("patient_organizations")
}

model Pregnancy {
  id                String          @id @default(uuid())
  patientId         String
  status            PregnancyStatus @default(ACTIVE)
  lastMenstrualDate DateTime?
  estimatedDueDate  DateTime?
  firstPrenatalAt   DateTime?
  gravida           Int?
  parity            Int?
  endedAt           DateTime?
  activeSlot        Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounters Encounter[]

  @@unique([patientId, activeSlot])
  @@index([patientId, status])
  @@index([status])
  @@map("pregnancies")
  registrationOperations ClinicalRegistrationOperation[] @relation("ClinicalRegistrationPregnancy")
}

model Encounter {
  id                 String          @id @default(uuid())
  patientId          String
  pregnancyId        String?
  organizationId     String
  status             EncounterStatus @default(DRAFT)
  chiefComplaint     String?
  occurredAt         DateTime        @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  pregnancy           Pregnancy?           @relation(fields: [pregnancyId], references: [id], onDelete: Restrict)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vitalSigns          VitalSigns?
  obstetricData       ObstetricData?
  clinicalEvaluations ClinicalEvaluation[]

  @@index([organizationId, occurredAt])
  @@index([organizationId, status, occurredAt])
  @@index([patientId, occurredAt])
  @@index([pregnancyId, occurredAt])
  @@index([status])
  @@map("encounters")
  clinicalProvenanceEvents ClinicalProvenanceEvent[]
  registrationOperation ClinicalRegistrationOperation? @relation("ClinicalRegistrationEncounter")
}

model VitalSigns {
  id               String             @id @default(uuid())
  encounterId      String             @unique
  systolicBp       Int
  diastolicBp      Int
  heartRate        Int
  respiratoryRate  Int
  temperature      Decimal?           @db.Decimal(4, 1)
  oxygenSaturation Int?
  consciousness    ConsciousnessState @default(ALERT)
  urineOutputMl    Int?
  proteinuria      ProteinuriaResult  @default(NOT_PERFORMED)
  recordedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([recordedAt])
  @@map("vital_signs")
}

model ObstetricData {
  id              String     @id @default(uuid())
  encounterId     String     @unique
  uterineHeightCm Decimal?   @db.Decimal(5, 2)
  fetalHeartRate  Int?
  fetalMovement   Boolean?
  edema           EdemaGrade @default(NONE)
  bleeding        Boolean?
  weightKg        Decimal?   @db.Decimal(6, 2)
  complaints      String?
  notes           String?
  recordedAt      DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([recordedAt])
  @@map("obstetric_data")
}

model Allergy {
  id        String        @id @default(uuid())
  patientId String
  substance String
  reaction  String?
  severity  String?
  status    AllergyStatus @default(ACTIVE)
  notedAt   DateTime      @default(now())
  endedAt   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([patientId, notedAt])
  @@map("allergies")
}

model ClinicalFlag {
  id         String             @id @default(uuid())
  patientId  String
  code       String
  label      String
  details    String?
  status     ClinicalFlagStatus @default(ACTIVE)
  activeSlot Int?               @default(1)
  notedAt    DateTime           @default(now())
  endedAt    DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([patientId, code, activeSlot])
  @@index([patientId, status])
  @@index([patientId, notedAt])
  @@index([status])
  @@map("clinical_flags")
}

model ClinicalEvaluation {
  id                   String                @id @default(uuid())
  patientId            String
  encounterId          String?
  status               MeowsEvaluationStatus
  meowsScore           Int?
  alertLevel           AlertLevel?
  protocolId           String
  protocolVersion      String
  protocolStatus       String
  clinicallyValidated  Boolean               @default(false)
  componentScores      Json?
  missingParameters    String[]              @default([])
  unresolvedParameters String[]              @default([])
  clinicalNotes        String?
  evaluatedAt          DateTime              @default(now())
  createdAt            DateTime              @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([patientId, evaluatedAt])
  @@index([encounterId, evaluatedAt])
  @@index([status, evaluatedAt])
  @@map("clinical_evaluations")
  registrationOperation ClinicalRegistrationOperation? @relation("ClinicalRegistrationEvaluation")
}

model OrganizationHealthAlert {
  id              String                          @id @default(uuid())
  organizationId  String
  type            OrganizationHealthAlertType
  severity        OrganizationHealthAlertSeverity
  status          OrganizationHealthAlertStatus   @default(OPEN)
  title           String
  message         String
  observedValue   Float?
  thresholdValue  Float?
  periodStart     DateTime?
  periodEnd       DateTime?
  details         Json?
  firstDetectedAt DateTime                        @default(now())
  lastDetectedAt  DateTime                        @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([type, status])
  @@index([lastDetectedAt])
  @@map("organization_health_alerts")
}

model ProductFeedback {
  id                String                  @id @default(uuid())
  organizationId    String
  actorUserId       String?
  resolvedByUserId  String?
  category          ProductFeedbackCategory
  status            ProductFeedbackStatus   @default(OPEN)
  source            ProductFeedbackSource
  satisfactionScore Int?
  message           String?
  resolutionNote    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  triagedAt         DateTime?
  startedAt         DateTime?
  resolvedAt        DateTime?
  dismissedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ProductFeedbackActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?        @relation("ProductFeedbackResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([category, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resolvedByUserId, resolvedAt])
  @@map("product_feedback")
}

model OrganizationMetricSnapshot {
  id                   String   @id @default(uuid())
  organizationId       String
  periodStart          DateTime
  periodEnd            DateTime
  eventCount           Int      @default(0)
  activeUsers          Int      @default(0)
  dashboardViews       Int      @default(0)
  patientSearches      Int      @default(0)
  encountersStarted    Int      @default(0)
  encountersCompleted  Int      @default(0)
  feedbackOpened       Int      @default(0)
  organizationSwitches Int      @default(0)
  featureUsage         Json?
  generatedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, periodStart])
  @@index([periodStart, periodEnd])
  @@map("organization_metric_snapshots")
}

model ProductActivityEvent {
  id             String   @id @default(uuid())
  actorUserId    String?
  organizationId String?
  eventKey       String
  resourceType   String?
  resourceId     String?
  screen         String?
  sessionId      String?
  requestId      String?
  correlationId  String?
  metadata       Json?
  occurredAt     DateTime @default(now())

  actor        User?         @relation("ProductActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation("ProductActivityOrganization", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([eventKey, occurredAt])
  @@index([resourceType, resourceId])
  @@index([correlationId, occurredAt])
  @@map("product_activity_events")
}

model AuditEvent {
  id             String       @id @default(uuid())
  actorUserId    String?
  organizationId String?
  patientId      String?
  action         String
  resourceType   String
  resourceId     String?
  outcome        AuditOutcome @default(SUCCESS)
  reason         String?
  requestId      String?
  correlationId  String?
  sessionId      String?
  ipHash         String?
  userAgent      String?
  before         Json?
  after          Json?
  metadata       Json?
  occurredAt     DateTime     @default(now())

  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  patient Patient? @relation("ClinicalAuditPatient", fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([patientId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([correlationId, occurredAt])
  @@index([action, occurredAt])
  @@index([outcome, occurredAt])
  @@map("audit_events")
}

model RNDSIntegration {
  id            String                 @id @default(uuid())
  healthUnitId  String                 @unique
  environment   IntegrationEnvironment @default(SANDBOX)
  status        RNDSIntegrationStatus  @default(NOT_REQUESTED)
  statusMessage String?
  requestedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  activatedAt   DateTime?
  suspendedAt   DateTime?
  lastCheckedAt DateTime?
  configuration Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  healthUnit     Organization                   @relation(fields: [healthUnitId], references: [id], onDelete: Restrict)
  approvedBy     User?                          @relation("RNDSApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  policies       IntegrationPolicy[]
  validationRuns RNDSValidationRun[]
  transmissions  InteroperabilityTransmission[]

  @@index([status, environment])
  @@map("rnds_integrations")
}

model IntegrationPolicy {
  id                String                  @id @default(uuid())
  rndsIntegrationId String
  resourceType      String
  action            IntegrationPolicyAction
  enabled           Boolean                 @default(true)
  rules             Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  rndsIntegration RNDSIntegration @relation(fields: [rndsIntegrationId], references: [id], onDelete: Cascade)

  @@unique([rndsIntegrationId, resourceType])
  @@map("integration_policies")
}

model RNDSValidationRun {
  id                String              @id @default(uuid())
  rndsIntegrationId String
  requestedById     String?
  status            ValidationRunStatus @default(PENDING)
  version           String
  startedAt         DateTime?
  finishedAt        DateTime?
  summary           Json?
  createdAt         DateTime            @default(now())

  rndsIntegration RNDSIntegration        @relation(fields: [rndsIntegrationId], references: [id], onDelete: Cascade)
  requestedBy     User?                  @relation("ValidationRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  results         RNDSValidationResult[]

  @@index([rndsIntegrationId, createdAt])
  @@map("rnds_validation_runs")
}

model RNDSValidationResult {
  id        String                 @id @default(uuid())
  runId     String
  checkKey  String
  status    ValidationResultStatus
  message   String?
  evidence  Json?
  checkedAt DateTime               @default(now())

  run RNDSValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, checkKey])
  @@map("rnds_validation_results")
}

enum TransmissionStatus {
  QUEUED
  SENDING
  ACKNOWLEDGED
  FAILED
  RETRY_SCHEDULED
  CANCELLED
}

model InteroperabilityTransmission {
  id                String             @id @default(uuid())
  rndsIntegrationId String
  resourceType      String
  resourceId        String
  correlationId     String             @unique
  status            TransmissionStatus @default(QUEUED)
  attempt           Int                @default(0)
  requestedAt       DateTime           @default(now())
  lastAttemptAt     DateTime?
  acknowledgedAt    DateTime?
  externalReference String?
  errorCode         String?
  errorMetadata     Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  rndsIntegration RNDSIntegration @relation(fields: [rndsIntegrationId], references: [id], onDelete: Restrict)

  @@index([rndsIntegrationId, status, requestedAt])
  @@index([resourceType, resourceId])
  @@map("interoperability_transmissions")
}

// ============================================================
// FOUNDATION 02 - IDENTITY & ACCESS
// ============================================================

enum PasswordAlgorithm {
  ARGON2ID
}

enum MfaFactorType {
  TOTP
}

enum MfaFactorStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum SessionRevocationReason {
  LOGOUT
  PASSWORD_CHANGED
  MFA_RESET
  ADMIN_REVOKED
  USER_SUSPENDED
  SECURITY_EVENT
}

model PasswordCredential {
  id           String            @id @default(uuid())
  userId       String            @unique
  passwordHash String
  algorithm    PasswordAlgorithm @default(ARGON2ID)
  mustChange   Boolean           @default(false)
  changedAt    DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model MfaFactor {
  id              String          @id @default(uuid())
  userId          String
  type            MfaFactorType   @default(TOTP)
  status          MfaFactorStatus @default(PENDING)
  secretEncrypted String
  label           String?
  createdAt       DateTime        @default(now())
  enabledAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model Session {
  id               String                   @id @default(uuid())
  userId           String
  tokenHash        String                   @unique
  createdAt        DateTime                 @default(now())
  expiresAt        DateTime
  lastSeenAt       DateTime                 @default(now())
  mfaVerifiedAt    DateTime?
  revokedAt        DateTime?
  revocationReason SessionRevocationReason?
  ipHash           String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum LoginAttemptOutcome {
  SUCCESS
  FAILURE
  THROTTLED
}

model LoginAttempt {
  id           String              @id @default(uuid())
  identityHash String
  originHash   String
  outcome      LoginAttemptOutcome
  occurredAt   DateTime            @default(now())

  @@index([identityHash, occurredAt])
  @@index([originHash, occurredAt])
  @@index([originHash, identityHash, occurredAt])
  @@map("login_attempts")
}

model MfaChallenge {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

// F04.5F - one-time password reset, no plaintext credentials in storage.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  originHash  String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([originHash, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Durable, bounded time-window counters; no IP/email is stored in cleartext.
model BetaAbuseBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("beta_abuse_buckets")
}

// No bodies, recipient addresses, links or bearer secrets are stored here.
model TransactionalEmail {
  id                String @id @default(uuid())
  keyHash           String @unique
  contentHash       String
  provider          String
  status            String @default("PENDING")
  providerMessageId String? @unique
  referenceKind     String?
  referenceId       String?
  referenceVersion  Int?
  attempts          Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  events            TransactionalEmailEvent[]

  @@index([referenceKind, referenceId])
  @@map("transactional_emails")
}

model TransactionalEmailEvent {
  id          String @id @default(uuid())
  eventHash   String @unique
  emailId     String
  kind        String
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  email       TransactionalEmail @relation(fields: [emailId], references: [id], onDelete: Restrict)

  @@index([emailId, occurredAt])
  @@map("transactional_email_events")
}

model OrganizationActivationNotice {
  id               String @id @default(uuid())
  organizationId   String
  userId           String
  organizationName String
  activatedAt      DateTime
  emailStatus      String @default("PENDING")
  createdAt        DateTime @default(now())

  @@unique([organizationId, userId, activatedAt], map: "activation_notice_recipient_event_key")
  @@index([organizationId, emailStatus])
  @@map("organization_activation_notices")
}

/// Private clinical ledger; legacy records are not backfilled with invented authors.
model ClinicalProvenanceEvent {
  id                 String                   @id @default(uuid())
  actorUserId        String
  organizationId     String
  patientId          String
  encounterId        String?
  resourceType       String
  resourceId         String
  kind               ClinicalProvenanceKind
  status             ClinicalProvenanceStatus
  reason             String
  before             Json
  after              Json
  proposedAfter      Json?
  sourceSnapshotHash String
  sessionId          String?
  requestId          String?
  correlationId      String?
  occurredAt         DateTime                 @default(now())

  actor        User         @relation("ClinicalProvenanceActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "clinical_provenance_actor_fkey")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "clinical_provenance_organization_fkey")
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict, map: "clinical_provenance_patient_fkey")
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict, map: "clinical_provenance_encounter_fkey")

  @@index([patientId, organizationId, occurredAt], map: "clinical_provenance_patient_scope_time_idx")
  @@index([resourceType, resourceId, occurredAt], map: "clinical_provenance_resource_time_idx")
  @@index([actorUserId, occurredAt], map: "clinical_provenance_actor_time_idx")
  @@map("clinical_provenance_events")
}

// PENDING is transaction-local only: a deferred trigger forbids committing it.
enum ClinicalRegistrationOperationStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model ClinicalRegistrationOperation {
  id                 String @id @default(uuid())
  actorUserId        String
  organizationId     String
  keyHash            String
  requestFingerprint String?
  status             ClinicalRegistrationOperationStatus @default(PENDING)
  patientId          String?
  pregnancyId        String?
  encounterId        String? @unique
  evaluationId       String? @unique
  createdAt          DateTime @default(now())
  completedAt        DateTime?

  actor        User @relation("ClinicalRegistrationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  organization Organization @relation("ClinicalRegistrationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient? @relation("ClinicalRegistrationPatient", fields: [patientId], references: [id], onDelete: Restrict)
  pregnancy    Pregnancy? @relation("ClinicalRegistrationPregnancy", fields: [pregnancyId], references: [id], onDelete: Restrict)
  encounter    Encounter? @relation("ClinicalRegistrationEncounter", fields: [encounterId], references: [id], onDelete: Restrict)
  evaluation   ClinicalEvaluation? @relation("ClinicalRegistrationEvaluation", fields: [evaluationId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, organizationId, keyHash])
  @@index([organizationId, createdAt])
  @@index([patientId])
  @@index([pregnancyId])
  @@map("clinical_registration_operations")
}


// Beta1 LMS: independent from clinical records. Published content is immutable.
model Course {
 id String @id @default(uuid())
 creationKey String? @unique
 creationHash String?
 slug String @unique
 creatorUserId String
 archivedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 creator User @relation("CourseAuthor", fields:[creatorUserId],references:[id],onDelete:Restrict)
 versions CourseVersion[]
 @@index([creatorUserId,createdAt])
 @@map("courses")
}
model CourseVersion {
 id String @id @default(uuid())
 courseId String
 versionNo Int
 schemaVersion Int @default(1)
 revision Int @default(1)
 title String
 description String
 category String
 level String @default("INTRODUCTORY")
 language String @default("pt-BR")
 thumbnail String @default("pre-natal")
 estimatedMinutes Int
 publishedAt DateTime?
 immutableContentHash String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 course Course @relation(fields:[courseId],references:[id],onDelete:Restrict)
 modules CourseModule[]
 assessment CourseAssessment?
 publication CoursePublication?
 enrollments CourseEnrollment[]
 @@unique([courseId,versionNo])
 @@map("course_versions")
}
model CourseModule {
 id String @id @default(uuid())
 courseVersionId String
 title String
 sortOrder Int
 version CourseVersion @relation(fields:[courseVersionId],references:[id],onDelete:Cascade)
 lessons CourseLesson[]
 @@unique([courseVersionId,sortOrder])
 @@map("course_modules")
}
model CourseLesson {
 id String @id @default(uuid())
 moduleId String
 title String
 sortOrder Int
 contentBlocks Json
 estimatedMinutes Int @default(5)
 module CourseModule @relation(fields:[moduleId],references:[id],onDelete:Cascade)
 progress CourseProgress[]
 @@unique([moduleId,sortOrder])
 @@map("course_lessons")
}
model CourseAsset {
 id String @id @default(uuid())
 createdBy String
 checksum String
 mime String
 sizeBytes Int
 storageKey String @unique
 license String
 createdAt DateTime @default(now())
 creator User @relation(fields:[createdBy],references:[id],onDelete:Restrict)
 @@map("course_assets")
}
model CourseAssessment {
 id String @id @default(uuid())
 courseVersionId String @unique
 passingScore Int @default(70)
 maxAttempts Int @default(3)
 requiredForCompletion Boolean @default(true)
 version CourseVersion @relation(fields:[courseVersionId],references:[id],onDelete:Cascade)
 questions CourseQuestion[]
 attempts CourseAttempt[]
 @@map("course_assessments")
}
model CourseQuestion {
 id String @id @default(uuid())
 assessmentId String
 sortOrder Int
 prompt String
 options Json
 correctIndex Int
 assessment CourseAssessment @relation(fields:[assessmentId],references:[id],onDelete:Cascade)
 @@unique([assessmentId,sortOrder])
 @@map("course_questions")
}
model CoursePublication {
 id String @id @default(uuid())
 courseVersionId String @unique
 publishedBy String
 publishedAt DateTime @default(now())
 archivedAt DateTime?
 revokedAt DateTime?
 version CourseVersion @relation(fields:[courseVersionId],references:[id],onDelete:Restrict)
 publisher User @relation(fields:[publishedBy],references:[id],onDelete:Restrict)
 audiences CourseAudience[]
 assignments CourseAssignment[]
 notifications UserNotification[]
 @@map("course_publications")
}
model CourseAudience {
 id String @id @default(uuid())
 publicationId String
 organizationId String
 releasedBy String
 releasedAt DateTime @default(now())
 revokedAt DateTime?
 publication CoursePublication @relation(fields:[publicationId],references:[id],onDelete:Restrict)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 releaser User @relation(fields:[releasedBy],references:[id],onDelete:Restrict)
 @@unique([publicationId,organizationId])
 @@index([organizationId,revokedAt])
 @@map("course_audiences")
}
model CourseAssignment {
 id String @id @default(uuid())
 publicationId String
 organizationId String
 professionalUserId String
 assignedBy String
 obligation String @default("RECOMMENDED")
 deadlineAt DateTime?
 notifiedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
 publication CoursePublication @relation(fields:[publicationId],references:[id],onDelete:Restrict)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 professional User @relation("CourseRecipient",fields:[professionalUserId],references:[id],onDelete:Restrict)
 assigner User @relation("CourseAssigner",fields:[assignedBy],references:[id],onDelete:Restrict)
 enrollment CourseEnrollment?
 @@unique([publicationId,organizationId,professionalUserId])
 @@index([organizationId,deadlineAt])
 @@map("course_assignments")
}
model CourseEnrollment {
 id String @id @default(uuid())
 assignmentId String @unique
 learnerUserId String
 courseVersionId String
 startedAt DateTime?
 completedAt DateTime?
 lastLessonId String?
 seenAt DateTime?
 revision Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 assignment CourseAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict)
 learner User @relation(fields:[learnerUserId],references:[id],onDelete:Restrict)
 version CourseVersion @relation(fields:[courseVersionId],references:[id],onDelete:Restrict)
 progress CourseProgress[]
 attempts CourseAttempt[]
 notifications UserNotification[]
 @@index([learnerUserId,completedAt])
 @@map("course_enrollments")
}
model CourseProgress {
 id String @id @default(uuid())
 enrollmentId String
 lessonId String
 completedAt DateTime?
 lastVisitedAt DateTime @default(now())
 revision Int @default(1)
 checkpointDigest String?
 enrollment CourseEnrollment @relation(fields:[enrollmentId],references:[id],onDelete:Restrict)
 lesson CourseLesson @relation(fields:[lessonId],references:[id],onDelete:Restrict)
 @@unique([enrollmentId,lessonId])
 @@map("course_progress")
}
model CourseAttempt {
 id String @id @default(uuid())
 enrollmentId String
 assessmentId String
 requestKey String
 requestHash String
 attemptNo Int
 scoreValidated Int
 passed Boolean
 answersDigest String
 submittedAt DateTime @default(now())
 enrollment CourseEnrollment @relation(fields:[enrollmentId],references:[id],onDelete:Restrict)
 assessment CourseAssessment @relation(fields:[assessmentId],references:[id],onDelete:Restrict)
 @@unique([enrollmentId,requestKey])
 @@unique([enrollmentId,assessmentId,attemptNo])
 @@map("course_attempts")
}
