generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AlertLevel {
  GREEN
  YELLOW
  RED
}

enum ConsciousnessState {
  ALERT
  VOICE
  PAIN
  UNRESPONSIVE
}

enum OrganizationType {
  PAP
  MUNICIPALITY
  HEALTH_UNIT
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  REQUESTED
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationCandidateStatus {
  NEW
  QUALIFYING
  CONTACTED
  INTERESTED
  VALIDATING
  APPROVED
  REJECTED
  DUPLICATE
  CLOSED
}

enum OrganizationLeadTemperature {
  COLD
  WARM
  HOT
}

enum OrganizationRequestStatus {
  REQUESTED
  WITHDRAWN
  RESOLVED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum PregnancyStatus {
  ACTIVE
  COMPLETED
  INTERRUPTED
}

enum EncounterStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EdemaGrade {
  NONE
  ONE_PLUS
  TWO_PLUS
  THREE_PLUS
  FOUR_PLUS
}

enum ProteinuriaResult {
  NOT_PERFORMED
  NEGATIVE
  TRACE
  ONE_PLUS
  TWO_PLUS
  THREE_PLUS
  FOUR_PLUS
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  RESOLVED
  ENTERED_IN_ERROR
}

enum IntegrationEnvironment {
  SANDBOX
  HOMOLOGATION
  PRODUCTION
}

enum RNDSIntegrationStatus {
  NOT_REQUESTED
  REQUESTED
  CONFIGURING
  VALIDATING
  HOMOLOGATION
  PENDING_PAP_APPROVAL
  APPROVED
  ACTIVE
  DEGRADED
  SUSPENDED
  DISABLED
}

enum ValidationRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

enum ValidationResultStatus {
  PASSED
  FAILED
  SKIPPED
}

enum IntegrationPolicyAction {
  ALLOW
  DENY
}

enum ProductFeedbackCategory {
  BUG
  USABILITY
  FEATURE_REQUEST
  PERFORMANCE
  SUPPORT
  OTHER
}

enum ProductFeedbackStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ProductFeedbackSource {
  WEB
  MOBILE
  SUPPORT
  ADMIN
}

enum OrganizationHealthAlertType {
  LOW_ACTIVITY
  LOW_SATISFACTION
  FEEDBACK_BACKLOG
}

enum OrganizationHealthAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OrganizationHealthAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships             Membership[]
  organizationRequests    OrganizationRequest[]
  roleAssignments         RoleAssignment[]
  auditEvents             AuditEvent[]          @relation("AuditActor")
  approvedRndIntegrations RNDSIntegration[]     @relation("RNDSApprovedBy")
  validationRuns          RNDSValidationRun[]   @relation("ValidationRunRequestedBy")

  passwordCredential    PasswordCredential?
  mfaFactors            MfaFactor[]
  mfaRecoveryCodes      MfaRecoveryCode[]
  mfaChallenges         MfaChallenge[]
  sessions              Session[]
  productActivityEvents ProductActivityEvent[] @relation("ProductActivityActor")

  submittedFeedback ProductFeedback[] @relation("ProductFeedbackActor")
  resolvedFeedback  ProductFeedback[] @relation("ProductFeedbackResolver")

  @@map("users")
}

model Organization {
  id        String             @id @default(uuid())
  type      OrganizationType
  status    OrganizationStatus @default(PENDING_VERIFICATION)
  name      String
  code      String?            @unique
  cnes      String?            @unique
  cnpj      String?            @unique
  city      String?
  state     String?
  address   String?
  parentId  String?
  parent    Organization?      @relation("OrganizationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Organization[]     @relation("OrganizationTree")
  isActive  Boolean            @default(true)
  settings  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships           Membership[]
  sourceCandidate       OrganizationCandidate?       @relation("CandidateConversion")
  roleAssignments       RoleAssignment[]
  patientLinks          PatientOrganization[]
  encounters            Encounter[]
  rndsIntegration       RNDSIntegration?
  productActivityEvents ProductActivityEvent[]       @relation("ProductActivityOrganization")
  metricSnapshots       OrganizationMetricSnapshot[]

  productFeedback ProductFeedback[]

  healthAlerts OrganizationHealthAlert[]

  @@index([parentId])
  @@index([type, status])
  @@index([city, state])
  @@index([name])
  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

model OrganizationCandidate {
  id                      String                      @id @default(uuid())
  type                    OrganizationType
  name                    String
  normalizedName          String
  dedupeKey               String                      @unique
  cnes                    String?                     @unique
  cnpj                    String?
  city                    String?
  state                   String?
  address                 String?
  status                  OrganizationCandidateStatus @default(NEW)
  leadTemperature         OrganizationLeadTemperature @default(COLD)
  convertedOrganizationId String?                     @unique
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  convertedOrganization Organization?         @relation("CandidateConversion", fields: [convertedOrganizationId], references: [id], onDelete: SetNull)
  requests              OrganizationRequest[]

  @@index([type, status])
  @@index([leadTemperature, status])
  @@index([city, state])
  @@index([normalizedName])
  @@map("organization_candidates")
}

model OrganizationRequest {
  id                String                    @id @default(uuid())
  candidateId       String
  requestedByUserId String
  status            OrganizationRequestStatus @default(REQUESTED)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  candidate   OrganizationCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requestedBy User                  @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@unique([candidateId, requestedByUserId])
  @@index([requestedByUserId, status])
  @@index([candidateId, status])
  @@map("organization_requests")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions     RolePermission[]
  roleAssignments RoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id             String  @id @default(uuid())
  userId         String
  roleId         String
  organizationId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId, organizationId])
  @@map("role_assignments")
}

model Patient {
  id         String   @id @default(uuid())
  cpf        String?  @unique
  cns        String?  @unique
  fullName   String
  socialName String?
  birthDate  DateTime
  phone      String?
  email      String?
  address    String?
  city       String?
  state      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organizations       PatientOrganization[]
  pregnancies         Pregnancy[]
  encounters          Encounter[]
  allergies           Allergy[]
  clinicalEvaluations ClinicalEvaluation[]

  @@index([fullName, birthDate])
  @@index([birthDate])
  @@index([isActive])
  @@map("patients")
}

model PatientOrganization {
  id              String    @id @default(uuid())
  patientId       String
  organizationId  String
  medicalRecordNo String?
  isPrimary       Boolean   @default(false)
  linkedAt        DateTime  @default(now())
  unlinkedAt      DateTime?

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([patientId, organizationId])
  @@unique([organizationId, medicalRecordNo])
  @@index([organizationId, isPrimary])
  @@map("patient_organizations")
}

model Pregnancy {
  id                String          @id @default(uuid())
  patientId         String
  status            PregnancyStatus @default(ACTIVE)
  lastMenstrualDate DateTime?
  estimatedDueDate  DateTime?
  firstPrenatalAt   DateTime?
  gravida           Int?
  parity            Int?
  endedAt           DateTime?
  activeSlot        Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounters Encounter[]

  @@unique([patientId, activeSlot])
  @@index([patientId, status])
  @@index([status])
  @@map("pregnancies")
}

model Encounter {
  id                 String          @id @default(uuid())
  patientId          String
  pregnancyId        String?
  organizationId     String
  status             EncounterStatus @default(DRAFT)
  chiefComplaint     String?
  occurredAt         DateTime        @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  pregnancy           Pregnancy?           @relation(fields: [pregnancyId], references: [id], onDelete: Restrict)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vitalSigns          VitalSigns?
  obstetricData       ObstetricData?
  clinicalEvaluations ClinicalEvaluation[]

  @@index([organizationId, occurredAt])
  @@index([organizationId, status, occurredAt])
  @@index([patientId, occurredAt])
  @@index([pregnancyId, occurredAt])
  @@index([status])
  @@map("encounters")
}

model VitalSigns {
  id               String             @id @default(uuid())
  encounterId      String             @unique
  systolicBp       Int
  diastolicBp      Int
  heartRate        Int
  respiratoryRate  Int
  temperature      Decimal?           @db.Decimal(4, 1)
  oxygenSaturation Int?
  consciousness    ConsciousnessState @default(ALERT)
  urineOutputMl    Int?
  proteinuria      ProteinuriaResult  @default(NOT_PERFORMED)
  recordedAt       DateTime           @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("vital_signs")
}

model ObstetricData {
  id              String     @id @default(uuid())
  encounterId     String     @unique
  uterineHeightCm Decimal?   @db.Decimal(5, 2)
  fetalHeartRate  Int?
  fetalMovement   Boolean?
  edema           EdemaGrade @default(NONE)
  bleeding        Boolean?
  weightKg        Decimal?   @db.Decimal(6, 2)
  complaints      String?
  notes           String?

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("obstetric_data")
}

model Allergy {
  id        String        @id @default(uuid())
  patientId String
  substance String
  reaction  String?
  severity  String?
  status    AllergyStatus @default(ACTIVE)
  notedAt   DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@map("allergies")
}

model ClinicalEvaluation {
  id            String     @id @default(uuid())
  patientId     String
  encounterId   String?
  meowsScore    Int
  alertLevel    AlertLevel
  clinicalNotes String?
  evaluatedAt   DateTime   @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([patientId, evaluatedAt])
  @@index([encounterId, evaluatedAt])
  @@map("clinical_evaluations")
}

model OrganizationHealthAlert {
  id              String                          @id @default(uuid())
  organizationId  String
  type            OrganizationHealthAlertType
  severity        OrganizationHealthAlertSeverity
  status          OrganizationHealthAlertStatus   @default(OPEN)
  title           String
  message         String
  observedValue   Float?
  thresholdValue  Float?
  periodStart     DateTime?
  periodEnd       DateTime?
  details         Json?
  firstDetectedAt DateTime                        @default(now())
  lastDetectedAt  DateTime                        @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([type, status])
  @@index([lastDetectedAt])
  @@map("organization_health_alerts")
}

model ProductFeedback {
  id                String                  @id @default(uuid())
  organizationId    String
  actorUserId       String?
  resolvedByUserId  String?
  category          ProductFeedbackCategory
  status            ProductFeedbackStatus   @default(OPEN)
  source            ProductFeedbackSource
  satisfactionScore Int?
  message           String?
  resolutionNote    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  triagedAt         DateTime?
  startedAt         DateTime?
  resolvedAt        DateTime?
  dismissedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ProductFeedbackActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?        @relation("ProductFeedbackResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([category, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resolvedByUserId, resolvedAt])
  @@map("product_feedback")
}

model OrganizationMetricSnapshot {
  id                   String   @id @default(uuid())
  organizationId       String
  periodStart          DateTime
  periodEnd            DateTime
  eventCount           Int      @default(0)
  activeUsers          Int      @default(0)
  dashboardViews       Int      @default(0)
  patientSearches      Int      @default(0)
  encountersStarted    Int      @default(0)
  encountersCompleted  Int      @default(0)
  feedbackOpened       Int      @default(0)
  organizationSwitches Int      @default(0)
  featureUsage         Json?
  generatedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, periodStart])
  @@index([periodStart, periodEnd])
  @@map("organization_metric_snapshots")
}

model ProductActivityEvent {
  id             String   @id @default(uuid())
  actorUserId    String?
  organizationId String?
  eventKey       String
  resourceType   String?
  resourceId     String?
  screen         String?
  sessionId      String?
  requestId      String?
  correlationId  String?
  metadata       Json?
  occurredAt     DateTime @default(now())

  actor        User?         @relation("ProductActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation("ProductActivityOrganization", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([eventKey, occurredAt])
  @@index([resourceType, resourceId])
  @@index([correlationId, occurredAt])
  @@map("product_activity_events")
}

model AuditEvent {
  id             String       @id @default(uuid())
  actorUserId    String?
  organizationId String?
  action         String
  resourceType   String
  resourceId     String?
  outcome        AuditOutcome @default(SUCCESS)
  reason         String?
  requestId      String?
  correlationId  String?
  sessionId      String?
  ipHash         String?
  userAgent      String?
  before         Json?
  after          Json?
  metadata       Json?
  occurredAt     DateTime     @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([correlationId, occurredAt])
  @@map("audit_events")
}

model RNDSIntegration {
  id            String                 @id @default(uuid())
  healthUnitId  String                 @unique
  environment   IntegrationEnvironment @default(SANDBOX)
  status        RNDSIntegrationStatus  @default(NOT_REQUESTED)
  statusMessage String?
  requestedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  activatedAt   DateTime?
  suspendedAt   DateTime?
  lastCheckedAt DateTime?
  configuration Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  healthUnit     Organization                   @relation(fields: [healthUnitId], references: [id], onDelete: Restrict)
  approvedBy     User?                          @relation("RNDSApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  policies       IntegrationPolicy[]
  validationRuns RNDSValidationRun[]
  transmissions  InteroperabilityTransmission[]

  @@index([status, environment])
  @@map("rnds_integrations")
}

model IntegrationPolicy {
  id                String                  @id @default(uuid())
  rndsIntegrationId String
  resourceType      String
  action            IntegrationPolicyAction
  enabled           Boolean                 @default(true)
  rules             Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  rndsIntegration RNDSIntegration @relation(fields: [rndsIntegrationId], references: [id], onDelete: Cascade)

  @@unique([rndsIntegrationId, resourceType])
  @@map("integration_policies")
}

model RNDSValidationRun {
  id                String              @id @default(uuid())
  rndsIntegrationId String
  requestedById     String?
  status            ValidationRunStatus @default(PENDING)
  version           String
  startedAt         DateTime?
  finishedAt        DateTime?
  summary           Json?
  createdAt         DateTime            @default(now())

  rndsIntegration RNDSIntegration        @relation(fields: [rndsIntegrationId], references: [id], onDelete: Cascade)
  requestedBy     User?                  @relation("ValidationRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  results         RNDSValidationResult[]

  @@index([rndsIntegrationId, createdAt])
  @@map("rnds_validation_runs")
}

model RNDSValidationResult {
  id        String                 @id @default(uuid())
  runId     String
  checkKey  String
  status    ValidationResultStatus
  message   String?
  evidence  Json?
  checkedAt DateTime               @default(now())

  run RNDSValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, checkKey])
  @@map("rnds_validation_results")
}

enum TransmissionStatus {
  QUEUED
  SENDING
  ACKNOWLEDGED
  FAILED
  RETRY_SCHEDULED
  CANCELLED
}

model InteroperabilityTransmission {
  id                String             @id @default(uuid())
  rndsIntegrationId String
  resourceType      String
  resourceId        String
  correlationId     String             @unique
  status            TransmissionStatus @default(QUEUED)
  attempt           Int                @default(0)
  requestedAt       DateTime           @default(now())
  lastAttemptAt     DateTime?
  acknowledgedAt    DateTime?
  externalReference String?
  errorCode         String?
  errorMetadata     Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  rndsIntegration RNDSIntegration @relation(fields: [rndsIntegrationId], references: [id], onDelete: Restrict)

  @@index([rndsIntegrationId, status, requestedAt])
  @@index([resourceType, resourceId])
  @@map("interoperability_transmissions")
}

// ============================================================
// FOUNDATION 02 - IDENTITY & ACCESS
// ============================================================

enum PasswordAlgorithm {
  ARGON2ID
}

enum MfaFactorType {
  TOTP
}

enum MfaFactorStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum SessionRevocationReason {
  LOGOUT
  PASSWORD_CHANGED
  MFA_RESET
  ADMIN_REVOKED
  USER_SUSPENDED
  SECURITY_EVENT
}

model PasswordCredential {
  id           String            @id @default(uuid())
  userId       String            @unique
  passwordHash String
  algorithm    PasswordAlgorithm @default(ARGON2ID)
  mustChange   Boolean           @default(false)
  changedAt    DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model MfaFactor {
  id              String          @id @default(uuid())
  userId          String
  type            MfaFactorType   @default(TOTP)
  status          MfaFactorStatus @default(PENDING)
  secretEncrypted String
  label           String?
  createdAt       DateTime        @default(now())
  enabledAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model Session {
  id               String                   @id @default(uuid())
  userId           String
  tokenHash        String                   @unique
  createdAt        DateTime                 @default(now())
  expiresAt        DateTime
  lastSeenAt       DateTime                 @default(now())
  revokedAt        DateTime?
  revocationReason SessionRevocationReason?
  ipHash           String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum LoginAttemptOutcome {
  SUCCESS
  FAILURE
  THROTTLED
}

model LoginAttempt {
  id           String              @id @default(uuid())
  identityHash String
  originHash   String
  outcome      LoginAttemptOutcome
  occurredAt   DateTime            @default(now())

  @@index([identityHash, occurredAt])
  @@index([originHash, occurredAt])
  @@index([originHash, identityHash, occurredAt])
  @@map("login_attempts")
}

model MfaChallenge {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@index([expiresAt])
  @@map("mfa_challenges")
}
