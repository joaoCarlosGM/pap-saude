      "cve_id": "CVE-2026-94482",
      "url": "https://api.github.com/advisories/GHSA-p3m5-59mp-jv5r",
      "html_url": "https://github.com/advisories/GHSA-p3m5-59mp-jv5r",
      "summary": "Next.js: Denial of Service in App Router using Server Actions",
      "description": "## Impact\n\nCrafted requests targeting Next.js applications using App Router with at least one Server Action can lead to excessive CPU usage blocking processing of further requests in the same process.\n\n## Workarounds\n\nNo workaround exists besides upgrading. Applications using Pages Router or not using Server Actions are not vulnerable.",
      "type": "reviewed",
      "severity": "high",
      "repository_advisory_url": "https://api.github.com/repos/vercel/next.js/security-advisories/GHSA-p3m5-59mp-jv5r",
