+}
+
+// PENDING is transaction-local only: a deferred trigger forbids committing it.
+enum ClinicalRegistrationOperationStatus {
+  PENDING
+  COMPLETED
+  CANCELLED
+}
+
+model ClinicalRegistrationOperation {
+  id                 String @id @default(uuid())
+  actorUserId        String
+  organizationId     String
+  keyHash            String
+  requestFingerprint String?
+  status             ClinicalRegistrationOperationStatus @default(PENDING)
+  patientId          String?
+  pregnancyId        String?
+  encounterId        String? @unique
+  evaluationId       String? @unique
+  createdAt          DateTime @default(now())
