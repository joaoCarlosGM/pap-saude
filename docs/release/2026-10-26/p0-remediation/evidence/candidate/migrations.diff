+  actor        User @relation("ClinicalRegistrationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
+  organization Organization @relation("ClinicalRegistrationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
